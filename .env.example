# Postgres connection string. On Cloudflare Workers, point this at a Hyperdrive config instead (see README).
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres"

# At least 32 characters. Generate with: pnpm auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# Public URL of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that can always sign in. Use this to add the first user,
# then add everyone else from the Settings page.
ADMIN_EMAILS="you@example.com"

# Cloudflare R2 bucket for uploaded images (R2 > Manage API tokens, "Object Read & Write").
# The bucket needs a CORS rule that allows PUT from BETTER_AUTH_URL (see README).
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
# Public URL of the bucket: a custom domain or the r2.dev URL (no trailing slash).
R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# Postgres connection string. On Cloudflare Workers, point this at a Hyperdrive config instead (see README).
DATABASE_URL="postgres://postgres:password@localhost:5432/postgres"

# At least 32 characters. Generate with: pnpm auth:secret
BETTER_AUTH_SECRET="replace-with-at-least-32-characters"

# Public URL of this app (no trailing slash).
BETTER_AUTH_URL="http://localhost:3000"

# Google OAuth client (https://console.cloud.google.com/apis/credentials).
# Authorized redirect URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Comma-separated emails that can always sign in. Use this to add the first user,
# then add everyone else from the Settings page.
ADMIN_EMAILS="you@example.com"
# CRM Staff emails. Staff and Admin can manage inquiries.
# These CRM roles do not change existing CMS/settings permissions.
STAFF_EMAILS=""

# Cloudflare R2 bucket for uploaded images.
# The bucket needs a CORS rule that allows PUT from BETTER_AUTH_URL (see README).
# Account ID and bucket name: from the S3 API URL, https://<account-id>.r2.cloudflarestorage.com/<bucket>
R2_ACCOUNT_ID=""
R2_BUCKET=""
# Access key pair: R2 > Manage API tokens > Create API token, "Object Read & Write" on the bucket.
# Cloudflare shows the secret only once.
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
# Public URL of the bucket: a custom domain or the r2.dev URL (no trailing slash).
R2_PUBLIC_BASE_URL="https://pub-xxxx.r2.dev"

# Corporate public intake. Keep disabled until step 6 connects the website and
# deployment throttling is configured. Origins must be exact, without trailing slashes.
CORPORATE_INTAKE_ENABLED="false"
SITE_ORIGINS="http://localhost:4321"
TURNSTILE_SECRET_KEY=""
# Website widget must use action="corporate-inquiry". Its site key belongs in web/.

# Corporate emails are separate from workshop payment instructions.
# Replace all placeholders and use a verified sender before enabling delivery.
CORPORATE_EMAIL_ENABLED="false"
RESEND_API_KEY=""
CORPORATE_EMAIL_FROM="Adrian Ding Team <team@example.invalid>"
CORPORATE_REPLY_TO="sales@example.invalid"
CORPORATE_INQUIRY_RECIPIENTS="primary@example.invalid,secondary@example.invalid"
CORPORATE_TEAM_PHONE="[TEAM_PHONE]"
CORPORATE_CREDIBILITY_LINE="[APPROVED_CREDIBILITY_LINE]"
CORPORATE_PORTAL_URL="http://localhost:3000"
